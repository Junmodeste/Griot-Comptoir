# Meta Model API key (dev.meta.ai > API keys), e.g. LLM_...
# In a Claude Code cloud session with a network secret for api.meta.ai, any placeholder works:
# the proxy injects the real Authorization header.
MODEL_API_KEY=
# Optional overrides
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# Odoo (XML-RPC). Use an API key: Odoo > Preferences > Account Security > New API Key.
ODOO_URL=http://localhost:8069
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
